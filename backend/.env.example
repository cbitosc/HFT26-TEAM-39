# TRACE AI Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (SQLite default for prototype, supports PostgreSQL / SQLite path)
DATABASE_URL=sqlite:///./trace_ai.db

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=104857600

# Featherless AI Integration
# Secure server-side Featherless API configuration
# Never commit real keys to version control or expose to frontend
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
